<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Envio manual"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/campoNumero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Número do cliente"
        android:inputType="phone"
        android:maxLength="9" />

    <EditText
        android:id="@+id/campoMegas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Megabytes (100 a 10240)"
        android:inputType="number" />

    <Button
        android:id="@+id/botaoEnviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Adicionar à fila" />

    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp" />
</LinearLayout>
